// Configuración de Opciones de BIND9 (Forwarders, Recursión y Seguridad)
// Archivo de destino en Debian: /etc/bind/named.conf.options

options {
    directory "/var/cache/bind";

    // Permitir consultas recursivas desde nuestra subred local y localhost
    allow-query { localhost; 192.168.50.0/24; };
    allow-recursion { localhost; 192.168.50.0/24; };

    // Reenviadores (Forwarders): Servidores DNS públicos para resolver dominios externos (Internet)
    forwarders {
        8.8.8.8; // Google DNS
        1.1.1.1; // Cloudflare DNS
    };

    // Reenviar primero a los forwarders
    forward first;

    // Validación DNSSEC en modo automático
    dnssec-validation auto;

    // Escuchar consultas en IPv4 sobre la IP del servidor y localhost
    listen-on port 53 { 127.0.0.1; 192.168.50.10; };

    // Desactivar IPv6 si el laboratorio opera únicamente bajo IPv4
    listen-on-v6 { any; };
};

