;
; Archivo de Zona Inversa para subred 192.168.50.0/24
; Archivo de destino en Debian: /etc/bind/zones/db.192.168.50
;
$TTL    86400
@       IN      SOA     ns1.empresa.local. admin.empresa.local. (
                        2026110501      ; Serial
                        3600            ; Refresh
                        1800            ; Retry
                        1209600         ; Expire
                        86400 )         ; Negative Cache TTL

; Servidor de nombres autoritativo
@       IN      NS      ns1.empresa.local.

; ==============================================================================
; REGISTROS DE PUNTERO INVERSO (TIPO PTR)
; ==============================================================================
; El último octeto de la IP (10) resuelve al FQDN correspondiente
10      IN      PTR     ns1.empresa.local.
10      IN      PTR     server.empresa.local.
10      IN      PTR     www.empresa.local.
10      IN      PTR     mail.empresa.local.
10      IN      PTR     ftp.empresa.local.

